# Database Configuration
DATABASE_URL=postgresql://postgres:SIFRENIZ@localhost:5432/travelmind

# JWT Configuration
SECRET_KEY=travelmind-super-secret-key-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Maps API Key - console.cloud.google.com adresinden alın
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Açıklama:
# postgres → Veritabanı kullanıcı adı
# SIFRENIZ → PostgreSQL kurulumunda belirlediğiniz şifre
